		"@typescript-eslint/parser": "^8.8.0",
		"concurrently": "^8.2.2",
		"czg": "^1.10.0",
		"eslint": "^9.12.0",
		"eslint-plugin-hagemanto": "github:Delnegend/hagemanto",
		"eslint-plugin-nuxt": "^4.0.0",
		"eslint-plugin-tailwindcss": "^3.17.4",
		"globals": "^15.10.0",
		"husky": "^9.1.6",
		"nuxt": "^3.13.2"
	},
	"dependencies": {
		"debounce": "^2.1.0",
