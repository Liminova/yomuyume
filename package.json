		"@types/node": "^22.13.5",
		"@vite-pwa/nuxt": "0.10.6",
		"eslint": "^9.21.0",
		"eslint-plugin-hagemanto": "^5.0.1",
		"eslint-plugin-vue": "^9.32.0",
		"nuxt": "^3.15.4"
	},
	"dependencies": {
		"@pinia/nuxt": "^0.10.1",
		"@tanstack/vue-query": "^5.66.9",
		"@vueuse/core": "^12.7.0",
		"clsx": "^2.1.1",
		"debounce": "^2.2.0",
		"embla-carousel-autoplay": "^8.5.2",
