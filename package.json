	"scripts": {
		"lint:client": "eslint --fix --cache src/**/*.{ts,vue}",
		"lint:server": "cargo fmt && cargo clippy",
		"lint": "concurrently \"pnpm lint-client\" \"pnpm lint-server\"",
		"dev:client": "nuxt dev",
		"dev:server": "cargo run -p yomuyume",
		"dev": "concurrently \"pnpm dev-client\" \"pnpm dev-server\"",
		"postinstall": "nuxt prepare",
		"build:server": "cargo build -p yomuyume --release",
		"build:client": "nuxt generate",
		"build:wasm": "zsh /workspaces/yomuyume/src-server/blurhash-webp-wasm/build.sh && zsh /workspaces/yomuyume/src-server/jxl-webp-wasm/build.sh"
	},
	"devDependencies": {
		"@nuxtjs/color-mode": "3.5.2",
		"@nuxtjs/tailwindcss": "^6.13.1",
		"@types/node": "^22.12.0",
		"concurrently": "^9.1.2",
		"eslint": "^9.19.0",
		"eslint-plugin-hagemanto": "^3.2.5",
		"eslint-plugin-vue": "^9.32.0",
		"nuxt": "^3.15.3"
	},
	"dependencies": {
		"@pinia/nuxt": "^0.9.0",
		"@tanstack/vue-query": "^5.65.0",
		"@vueuse/core": "^12.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"debounce": "^2.2.0",
