{
	"name": "yomuyume",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"workspaceFolder": "/ymym",
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"bradlc.vscode-tailwindcss",
				"Vue.volar",
				"fill-labs.dependi",
				"tamasfe.even-better-toml",
				"esbenp.prettier-vscode"
			]
		}
	},
	"postCreateCommand": "zsh .devcontainer/postinstall.sh"
}